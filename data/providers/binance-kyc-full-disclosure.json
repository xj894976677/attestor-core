{
  "id": "binance-kyc-full-001",
  "providerId": "binance-kyc-full-disclosure",
  "httpProviderId": "binance-kyc-full-disclosure",
  "name": "Binance KYC Level (Full Disclosure)",
  "description": "Verify Binance KYC Level with full TLS disclosure - Name, Surname, DOB, Status. WARNING: All data visible to Attestor.",
  "logoUrl": "https://devtool-images.s3.ap-south-1.amazonaws.com/http-provider-brand-logos/binance.com-00a58378-085e-4a47-b651-1967548a06b3.png",
  "loginUrl": "https://www.binance.com/en/my/settings/kyc",
  "geoLocation": "{{DYNAMIC_GEO}}",
  "injectionType": "MSWJS",
  "disableRequestReplay": true,
  "verificationType": "WITNESS",
  "requestData": [
    {
      "url": "https://www.binance.com/bapi/kyc/v2/private/certificate/user-kyc/current-kyc-status",
      "expectedPageUrl": "",
      "urlType": "TEMPLATE",
      "method": "POST",
      "disableRedaction": true,
      "responseMatches": [
        { "type": "contains", "value": "\"currentKycLevel\":\"{{KYC_status}}\"", "invert": false, "isOptional": false },
        { "type": "contains", "value": "\"lastName\":\"{{Surname}}\"", "invert": false, "isOptional": false },
        { "type": "contains", "value": "\"dob\":\"{{DOB}}\"", "invert": false, "isOptional": false },
        { "type": "contains", "value": "\"firstName\":\"{{Name}}\"", "invert": false, "isOptional": false }
      ],
      "responseRedactions": [
        { "xPath": "", "jsonPath": "$.data.currentKycLevel", "regex": "\"currentKycLevel\":\"(.*)\"", "hash": "" },
        { "xPath": "", "jsonPath": "$.data.fillInfo.lastName", "regex": "\"lastName\":\"(.*)\"", "hash": "" },
        { "xPath": "", "jsonPath": "$.data.fillInfo.dob", "regex": "\"dob\":\"(.*)\"", "hash": "" },
        { "xPath": "", "jsonPath": "$.data.fillInfo.firstName", "regex": "\"firstName\":\"(.*)\"", "hash": "" }
      ],
      "bodySniff": { "enabled": false, "template": null },
      "responseVariables": ["KYC_status", "Surname", "DOB", "Name"],
      "writeRedactionMode": null,
      "additionalClientOptions": null,
      "credentials": null
    }
  ],
  "useIncognitoWebview": false,
  "customInjection": "",
  "userAgent": { "ios": "", "android": "" },
  "metadata": {
    "warning": "Full TLS disclosure mode - all data visible to Attestor",
    "useCase": "Self-hosted or fully trusted Attestor nodes only"
  },
  "version": { "major": 1, "minor": 0, "patch": 0 }
}
