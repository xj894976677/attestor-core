{
  "id": "binance-kyc-lite-zk-001",
  "providerId": "binance-kyc-lite-zk",
  "httpProviderId": "binance-kyc-lite-zk",
  "name": "Binance KYC Status (Lite/ZK)",
  "description": "Name, Surname, DOB, Status - via lite endpoint, ZK mode",
  "logoUrl": "https://devtool-images.s3.ap-south-1.amazonaws.com/http-provider-brand-logos/binance.com-00a58378-085e-4a47-b651-1967548a06b3.png",
  "loginUrl": "https://accounts.binance.com/en/login",
  "geoLocation": "PT",
  "injectionType": "MSWJS",
  "disableRequestReplay": true,
  "verificationType": "WITNESS",
  "requestData": [
    {
      "url": "https://www.binance.com/bapi/kyc/v2/private/certificate/user-kyc/current-kyc-status-lite",
      "expectedPageUrl": "",
      "urlType": "TEMPLATE",
      "method": "POST",
      "writeRedactionMode": "zk",
      "responseMatches": [
        { "value": "\"currentKycLevelStatus\":\"{{KYC_status}}\"", "type": "contains", "invert": false, "isOptional": false },
        { "value": "\"lastName\":\"{{Surname}}\"", "type": "contains", "invert": false, "isOptional": false },
        { "value": "\"dob\":\"{{DOB}}\"", "type": "contains", "invert": false, "isOptional": false },
        { "value": "\"firstName\":\"{{Name}}\"", "type": "contains", "invert": false, "isOptional": false }
      ],
      "responseRedactions": [
        { "xPath": "", "jsonPath": "$.data.currentKycLevelStatus", "regex": "\"currentKycLevelStatus\":\"(.*)\"", "hash": "" },
        { "xPath": "", "jsonPath": "$.data.fillInfo.lastName", "regex": "\"lastName\":\"(.*)\"", "hash": "" },
        { "xPath": "", "jsonPath": "$.data.fillInfo.dob", "regex": "\"dob\":\"(.*)\"", "hash": "" },
        { "xPath": "", "jsonPath": "$.data.fillInfo.firstName", "regex": "\"firstName\":\"(.*)\"", "hash": "" }
      ],
      "bodySniff": { "enabled": false, "template": null },
      "responseVariables": ["KYC_status", "Surname", "DOB", "Name"],
      "additionalClientOptions": null,
      "credentials": null
    }
  ],
  "useIncognitoWebview": false,
  "customInjection": "",
  "userAgent": { "ios": "", "android": "" },
  "metadata": {},
  "version": { "major": 1, "minor": 0, "patch": 0 }
}
