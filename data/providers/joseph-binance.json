  "requestData": [
    {
      "url": "https://www.binance.com/bapi/kyc/v2/private/certificate/user-kyc/current-kyc-status",
      "expectedPageUrl": "",
      "urlType": "TEMPLATE",
      "method": "POST",
      "writeRedactionMode": "key-update",
      "responseMatches": [
        { "type": "contains", "value": "\"currentKycLevel\":\"{{KYC_status}}\"", "invert": false },
        { "type": "contains", "value": "\"lastName\":\"{{Surname}}\"", "invert": false },
        { "type": "contains", "value": "\"dob\":\"{{DOB}}\"", "invert": false },
        { "type": "contains", "value": "\"firstName\":\"{{Name}}\"", "invert": false }
      ],
      "responseRedactions": [
        { "jsonPath": "$.data.currentKycLevel" },
        { "jsonPath": "$.data.fillInfo.lastName" },
        { "jsonPath": "$.data.fillInfo.dob" },
        { "jsonPath": "$.data.fillInfo.firstName" }
      ],
      "bodySniff": { "enabled": false, "template": null },
      "responseVariables": ["KYC_status", "Surname", "DOB", "Name"]
    }
  ],
  "useIncognitoWebview": false,
